<?xml version="1.0" encoding="UTF-8"?>
<!-- context.xml
     definisce il pool di connessioni a MySQL, lo crea Tomcat all'avvio dell'app
     name: jdbc/sportshop, e' il nome che cerca il DataSourceListener con JNDI
     url: db "sportshop" in locale sulla porta 3306 (&amp; e' la & scritta in xml)
     per cambiare db, utente o password si modifica qui
     maxTotal = connessioni massime, maxIdle = connessioni libere tenute pronte,
     maxWaitMillis = quanto aspettare una connessione libera prima di dare errore -->

<Context>
  <Resource name="jdbc/sportshop"
            auth="Container"
            type="javax.sql.DataSource"
            driverClassName="com.mysql.cj.jdbc.Driver"
            url="jdbc:mysql://localhost:3306/sportshop?serverTimezone=Europe/Rome&amp;characterEncoding=UTF-8"
            username="root"
            password="giovanni"
            maxTotal="20"
            maxIdle="5"
            maxWaitMillis="10000"/>
</Context>
